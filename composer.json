{
    "name": "respinar/contao-redirects",
    "description": " A simple Contao extension for URL redirects (301, 302) and 410 (Gone) responses. ",
    "keywords": ["contao", "bundle", "redirect", "301", "302", "410"],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Hamid Peywasti",
            "email": "hamid@respinar.com",
            "homepage": "https://respinar.com/",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/respinar/contao-redirects/issues",
        "source": "https://github.com/respinar/contao-redirects"
    },
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "contao/easy-coding-standard": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Respinar\\RedirectsBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Respinar\\RedirectsBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "contao/manager-plugin": true
        }
    }
}
